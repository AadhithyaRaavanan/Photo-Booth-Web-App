# ==============================================================================
# 🪔 MASTER STORE CONFIGURATION FILE (.env)
# ==============================================================================
# Customize every store detail, brand name, description, and social handles
# from this single file. Ideal for deploying/selling to different clients!
# ==============================================================================

# 1. BRAND & STORE IDENTITY
NEXT_PUBLIC_SHOP_NAME="Dream Salon"
NEXT_PUBLIC_SHOP_TAGLINE="BEAUTY · STYLE · CONFIDENCE"
NEXT_PUBLIC_STORE_ADDRESS="123 Royal Festive Promenade, Festive City"
NEXT_PUBLIC_PHONE_NUMBER="+91 98765 43210"

# 2. PROMOTIONAL CAMPAIGN & DISCOUNT
NEXT_PUBLIC_CAMPAIGN_HEADLINE="DIWALI PARTY"
NEXT_PUBLIC_CAMPAIGN_SUBTEXT="Capture your radiant festive celebration, frame your portrait with royal palace frames, and unlock your exclusive 30% OFF festive pass!"
NEXT_PUBLIC_DEFAULT_DISCOUNT="30%"
NEXT_PUBLIC_DISCOUNT_LABEL="FLAT 30% OFF"
NEXT_PUBLIC_VALIDITY_DATE="Nov 25, 2026"

# 3. SOCIAL MEDIA & STORY TAGGING (Shown prominently in final share section)
NEXT_PUBLIC_INSTAGRAM_TAG="@DreamSalon"
NEXT_PUBLIC_PARTNER_TAG="@ZenXea"
NEXT_PUBLIC_SHARE_HASHTAGS="#DiwaliFestive #DreamSalon #FestiveLook"

# 4. IN-STORE ADMIN PIN
ADMIN_PIN="1234"

# ==============================================================================
# 🐘 5. SUPABASE & PRISMA COUNTING SYSTEM
# Connect your Supabase PostgreSQL database to count photos & claimed coupons.
# Copy your connection string from: Supabase Project Settings -> Database -> Connection String
# (Leave blank or commented if using local resilient storage mode)
# ==============================================================================
DATABASE_URL=""
DIRECT_URL=""

